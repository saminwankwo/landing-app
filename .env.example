# Copy to `.env` and fill in EVERY value. Placeholders are rejected at runtime
# by the isPlaceholder() guard in src/utils/consent.js, so a fresh clone will
# never fire test traffic at a production pixel/form.
#
# Where to get each ID:
#   VITE_TIKTOK_PIXEL_ID   TikTok Ads Manager -> Events Manager -> Pixel
#   VITE_META_PIXEL_ID     Meta Events Manager -> Data Sources -> Settings
#   VITE_GA4_ID            Google Analytics -> Admin -> Data Streams
#   VITE_GOOGLE_ADS_ID     Google Ads -> Conversions (AW-XXXXXXXXXX)
#   VITE_FORMSPREE_ENDPOINT https://formspree.io/f/<your-form-id>
#   VITE_CALENDLY_URL      Calendly -> Your link
#   VITE_LEAD_TRACKER_WEBHOOK  campagin/lead-tracker API base + /api/webhooks/landing-lead
#   VITE_LEAD_TRACKER_SECRET   must match WEBHOOK_SECRET in campagin/lead-tracker/packages/api/.env

# ===== Public site URL (used for SEO + canonical links) =====
VITE_SITE_URL=https://your-landing-domain.com

# ===== Ad Pixels (empty / placeholder = pixel not loaded) =====
VITE_GTM_ID=
VITE_GA4_ID=G-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXX
VITE_TIKTOK_PIXEL_ID=<YOUR_TIKTOK_PIXEL_ID>
VITE_META_PIXEL_ID=<YOUR_META_PIXEL_ID>
VITE_CLARITY_PROJECT_ID=

# ===== Form / Bookings =====
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/<YOUR_FORM_ID>
VITE_CALENDLY_URL=https://calendly.com/<your-handle>/30min

# ===== Lead Tracker webhook (SN TECH Lead Tracker CRM) =====
# Format: {LEAD_TRACKER_API_BASE_URL}/api/webhooks/landing-lead
# Local dev example: http://localhost:4000/api/webhooks/landing-lead
# NOTE: this secret is shipped in the client bundle. That is acceptable for a
# public capture endpoint (spam deterrent only) — see TRACKING_SETUP.md §3.
VITE_LEAD_TRACKER_WEBHOOK=https://your-lead-tracker-api.example.com/api/webhooks/landing-lead
VITE_LEAD_TRACKER_SECRET=<YOUR_32_CHAR_WEBHOOK_SECRET>

# ===== Misc =====
VITE_ADSENSE_PUB_ID=
